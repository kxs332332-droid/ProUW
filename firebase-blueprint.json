{
  "entities": {
    "users": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "first_name": { "type": "string" },
        "last_name": { "type": "string" },
        "employee_id": { "type": "string" },
        "user_id": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] }
      },
      "required": ["first_name", "last_name", "employee_id", "user_id", "role"]
    },
    "questions": {
      "title": "Question",
      "description": "Test question",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["mcq", "yesno", "specific"] },
        "text": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" } },
        "correct_answer": { "type": "string" },
        "master_rationale": { "type": "string" },
        "format": { "type": "string", "enum": ["Text", "Number"] },
        "module": { "type": "integer" },
        "time_limit": { "type": "integer" }
      },
      "required": ["type", "text", "correct_answer", "module"]
    },
    "test_sessions": {
      "title": "Test Session",
      "description": "A test attempt by a user",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "module": { "type": "integer" },
        "total_questions": { "type": "integer" },
        "start_time": { "type": "string", "format": "date-time" },
        "end_time": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["in_progress", "completed", "published", "suspended", "denied"] },
        "total_score": { "type": "number" },
        "total_explanation_score": { "type": "number" },
        "violation_count": { "type": "integer" }
      },
      "required": ["user_id", "module", "status"]
    },
    "responses": {
      "title": "Response",
      "description": "User response to a question",
      "type": "object",
      "properties": {
        "session_id": { "type": "string" },
        "question_id": { "type": "string" },
        "answer": { "type": "string" },
        "explanation": { "type": "string" },
        "ai_explanation_score": { "type": "number" },
        "admin_score": { "type": "number" },
        "admin_explanation_score": { "type": "number" }
      },
      "required": ["session_id", "question_id", "answer"]
    },
    "activity_logs": {
      "title": "Activity Log",
      "description": "Audit log of user actions",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "action": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "details": { "type": "string" }
      },
      "required": ["user_id", "action", "timestamp"]
    },
    "resources": {
      "title": "Resource",
      "description": "PDF documents uploaded by admin",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "type": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "url"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "users",
      "description": "User profiles"
    },
    "resources/{resourceId}": {
      "schema": "resources",
      "description": "Admin uploaded resources"
    },
    "questions/{questionId}": {
      "schema": "questions",
      "description": "Test questions"
    },
    "test_sessions/{sessionId}": {
      "schema": "test_sessions",
      "description": "Test session metadata"
    },
    "test_sessions/{sessionId}/responses/{responseId}": {
      "schema": "responses",
      "description": "Responses within a session"
    },
    "activity_logs/{logId}": {
      "schema": "activity_logs",
      "description": "Audit logs"
    }
  }
}
